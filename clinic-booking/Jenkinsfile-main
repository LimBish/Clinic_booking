pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    environment {
        REPO_URL = "https://github.com/LimBish/Clinic_booking.git"
        BRANCH = "main"
        APP_DIR = "clinic-booking"
        JAR_NAME = "clinic-booking-1.0.0.jar"
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout from Git') {
            steps {
                git branch: "${BRANCH}",
                    url: "${REPO_URL}"
            }
        }

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    bat 'java -version'
                    bat 'mvn -version'
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Run Application') {
            steps {
                dir("${APP_DIR}/target") {
                    bat 'start java -jar %JAR_NAME%'
                }
            }
        }
    }

    post {
        success {
            echo 'Main branch pipeline executed successfully after GitHub push.'
        }
        failure {
            echo 'Main branch pipeline failed. Check console output.'
        }
    }
}